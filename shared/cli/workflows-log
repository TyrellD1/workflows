#!/usr/bin/env bash
# Append one workflow log event to ~/.workflows/logs/<workflow>/<date>.jsonl
# Bash only. No python.

set -euo pipefail

EVENTS="start step hitl condition poll error done"

workflow=""
event=""
step=""
template=""
status=""
message=""

usage() {
  echo "usage: workflows-log --workflow <id> --event <start|step|hitl|condition|poll|error|done> [--step <name>] [--template <hitl-file-stem>] [--status <escalated|resolved|gave_up|ok>] [--message <text>]" >&2
  exit 1
}

json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

valid_event() {
  local e=$1
  local x
  for x in $EVENTS; do
    [ "$x" = "$e" ] && return 0
  done
  return 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --workflow)
      workflow="${2:-}"
      shift 2
      ;;
    --event)
      event="${2:-}"
      shift 2
      ;;
    --step)
      step="${2:-}"
      shift 2
      ;;
    --template)
      template="${2:-}"
      shift 2
      ;;
    --status)
      status="${2:-}"
      shift 2
      ;;
    --message)
      message="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo "error: unknown arg: $1" >&2
      usage
      ;;
  esac
done

[ -n "$workflow" ] || { echo "error: --workflow is required" >&2; usage; }
[ -n "$event" ] || { echo "error: --event is required" >&2; usage; }
valid_event "$event" || { echo "error: --event must be one of: $EVENTS" >&2; exit 1; }

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
day=$(date -u +%Y-%m-%d)

json=$(printf '{"ts":"%s","workflow":"%s","event":"%s"' \
  "$(json_escape "$ts")" \
  "$(json_escape "$workflow")" \
  "$(json_escape "$event")")

append_opt() {
  local key=$1
  local val=$2
  [ -n "$val" ] || return 0
  json="${json},\"${key}\":\"$(json_escape "$val")\""
}

append_opt step "$step"
append_opt template "$template"
append_opt status "$status"
append_opt message "$message"
json="${json}}"

directory="${HOME}/.workflows/logs/${workflow}"
mkdir -p "$directory"
path="${directory}/${day}.jsonl"
printf '%s\n' "$json" >>"$path"
printf '%s\n' "$path"
