#!/usr/bin/env python3
"""Append one workflow log event to ~/.workflows/logs/<workflow>/<date>.jsonl"""

from __future__ import annotations

import argparse
import json
from datetime import datetime, timezone
from pathlib import Path

EVENTS = ("start", "step", "hitl", "condition", "poll", "error", "done")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workflow", required=True)
    parser.add_argument("--event", required=True, choices=EVENTS)
    parser.add_argument("--step")
    parser.add_argument("--template")
    parser.add_argument("--status")
    parser.add_argument("--message")
    args = parser.parse_args()

    now = datetime.now(timezone.utc)
    record = {
        "ts": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "workflow": args.workflow,
        "event": args.event,
    }
    for key in ("step", "template", "status", "message"):
        value = getattr(args, key)
        if value:
            record[key] = value

    directory = Path.home() / ".workflows" / "logs" / args.workflow
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{now.date().isoformat()}.jsonl"
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record) + "\n")
    print(path)


if __name__ == "__main__":
    main()
